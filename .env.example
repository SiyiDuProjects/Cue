OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Only the optional speaking mock interviewer uses Live.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_TRANSCRIPTION_LANGUAGES=
OPENAI_CODE_MODEL=gpt-6.1-sol
OPENAI_CODE_REASONING_EFFORT=xhigh
OPENAI_CODE_MAX_OUTPUT_TOKENS=32768
OPENAI_CODE_TIMEOUT_SECONDS=45
INTERVIEW_CONTEXT_DIR=
# Conversation records and code archives; leave unset for apps/server/data/workspace-history.
# Use a private persistent directory/volume outside the release folder in production.
# Empty disables disk persistence; raw audio is never stored.
# Conversation messages, screenshots, transcripts and code history (empty disables disk persistence).
# INTERVIEW_WORKSPACE_HISTORY_DIR=/var/lib/interview/workspace-history
INTERVIEW_ACCESS_TOKEN=
INTERVIEW_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
INTERVIEW_SESSION_TTL_SECONDS=3600
INTERVIEW_SCREENSHOT_MAX_BYTES=5242880
INTERVIEW_API_BASE_URL=https://interview.siyidu.com

# Local Codex: desktop-only optional absolute paths. Does not use OPENAI_API_KEY.
# INTERVIEW_CODEX_WORKSPACE=D:/Projects/Interview/assistant-workspace
# INTERVIEW_CODEX_BIN=C:/path/to/codex.exe
# Optional Sage Responses answering (server-side credentials only).
OPENAI_RESPONSES_MODEL=gpt-6.1-sol
OPENAI_RESPONSES_REASONING_EFFORT=xhigh
OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=32768
# Canonical HTTPS origin for ChatGPT's private read-only MCP and OAuth.
INTERVIEW_PUBLIC_URL=https://interview.siyidu.com
