{
  "name": "cue-desktop",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http-get://127.0.0.1:5173 && electron . --renderer-url=http://127.0.0.1:5173\"",
    "build": "tsc && vite build",
    "start:local": "npm run build && electron .",
    "test:ui": "electron tests/chat-ui-smoke.cjs && electron tests/direct-ui.cjs",
    "test:capture": "node --test tests/capture.test.cjs electron/desktop-connection.test.cjs electron/desktop-environment.test.cjs electron/screen-capture.test.cjs tests/direct-transcription.test.mjs",
    "prestart:desktop": "npm run build",
    "start:desktop": "electron .",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ozymandiasthegreat/vad": "2.0.7",
    "katex": "^0.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  }
}
