{
  "name": "interview-copilot-desktop",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http-get://127.0.0.1:5173 && electron . --renderer-url=http://127.0.0.1:5173\"",
    "build": "tsc && vite build",
    "prebuild": "node scripts/prepare-browser-preview.mjs",
    "start:local": "npm run build && node scripts/start-local.mjs",
    "build:browser-preview": "tsc -p tsconfig.preview.json && vite build --mode browser-preview",
    "prebuild:browser-preview": "node scripts/prepare-browser-preview.mjs",
    "preview:browser": "vite preview --mode browser-preview --host 127.0.0.1 --port 4175 --strictPort",
    "test:ui": "node --import tsx --test tests/*.test.tsx",
    "test:capture": "node --test tests/capture.test.cjs electron/*.test.cjs",
    "prestart:desktop": "npm run build",
    "start:desktop": "electron .",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@phosphor-icons/react": "^2.1.10",
    "diff": "^9.0.0",
    "katex": "0.16.47",
    "marked": "^18.0.0",
    "motion": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "rehype-katex": "7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "shiki": "^4.0.0",
    "streamdown": "^2.5.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@heroui-pro/react": "1.0.0-beta.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  }
}
